# Biến môi trường — KHÔNG commit file chứa secret thật (.env, .env.dev, ...)
#
# Dự án hỗ trợ 3 môi trường qua APP_ENV:
#   dev      → .env.dev      (local development)
#   staging  → .env.staging  (pre-production / QA)
#   prod     → .env.prod     (production)
#
# Thiết lập:
#   cp .env.dev.example .env.dev
#   cp .env.staging.example .env.staging
#   cp .env.prod.example .env.prod
#
# Chạy server:
#   pnpm dev                  # APP_ENV=dev (mặc định)
#   pnpm start:staging        # APP_ENV=staging
#   pnpm start:prod           # APP_ENV=prod
#
# Prisma migrate theo môi trường:
#   pnpm db:migrate:dev
#   pnpm db:deploy:staging
#   pnpm db:deploy:prod
#
# File .env (tùy chọn) chứa biến chung cho mọi môi trường.
# File .env.{APP_ENV} override .env khi app khởi động.
