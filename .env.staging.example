# Môi trường Staging — copy sang .env.staging và điền giá trị thật
# cp .env.staging.example .env.staging

APP_ENV=staging
NODE_ENV=production
PORT=3000

# Neon — pooled connection (runtime)
DATABASE_URL=postgresql://user:pass@ep-xxx-staging.neon.tech/neondb?sslmode=require&pgbouncer=true
# Neon — direct connection (prisma migrate)
DIRECT_URL=postgresql://user:pass@ep-xxx-staging.neon.tech/neondb?sslmode=require

JWT_SECRET=your-staging-secret-key-min-32-chars-long

# Cloudflare R2 Storage (staging)
R2_ACCOUNT_ID=your_staging_cloudflare_account_id
R2_ACCESS_KEY_ID=your_staging_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_staging_r2_secret_access_key
R2_BUCKET_NAME=job-management-staging
R2_PUBLIC_URL=https://pub-staging.r2.dev
